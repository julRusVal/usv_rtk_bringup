# Copy to config/secrets.yaml and fill in NTRIP credentials.
# Used only by ntrip_aux_client and check_swepos (not the Septentrio ROS driver).
# config/secrets.yaml is gitignored.

ntrip:
  caster: "nrtk-swepos.lm.se"
  caster_port: 8500
  username: "your_username"
  password: "your_password"
  mountpoint: "MSM_GNSS"
  version: "v2"
