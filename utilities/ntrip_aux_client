@dataclass
class GgaFix:
    lat: float
    lon: float
    alt: float
    sep: float
    quality: int
    num_sv: int
    hdop: float
    age: float
    station: int
    raw: bytes
    updated_at: float

    @property
    def valid(self) -> bool:
        return self.quality >= MIN_FIX_QUALITY

    def fix_string(self) -> str:
        return FIXTYPE_GGA.get(self.quality, "3D")

    def as_coordinates(self) -> dict:
        return {
            "lat": self.lat,
            "lon": self.lon,
            "alt": self.alt,
            "sep": self.sep,
            "fix": self.fix_string(),
            "sip": self.num_sv,
            "hdop": self.hdop,
            "diffage": self.age,
            "diffstation": self.station,
        }


def gga_fix_from_parsed(parsed, raw: bytes) -> GgaFix | None:
    if parsed is None or getattr(parsed, "msgID", "") != "GGA":
        return None
    quality = int(getattr(parsed, "quality", 0))
    return GgaFix(
        lat=float(parsed.lat),
        lon=float(parsed.lon),
        alt=float(getattr(parsed, "alt", 0.0) or 0.0),
        sep=float(getattr(parsed, "sep", 0.0) or 0.0),
        quality=quality,
        num_sv=int(getattr(parsed, "numSV", 0) or 0),
        hdop=float(getattr(parsed, "HDOP", 0.0) or 0.0),
        age=float(getattr(parsed, "diffAge", 0.0) or 0.0),
        station=int(getattr(parsed, "diffStation", 0) or 0),
        raw=raw if isinstance(raw, (bytes, bytearray)) else bytes(raw),
        updated_at=time.monotonic(),
    )


class GgaMonitor:
    """Read NMEA from aux serial and track the latest GGA fix."""

    def __init__(self, ser: serial.Serial):
        self._ser = ser
        self._lock = threading.Lock()
        self._latest: GgaFix | None = None
        self._stop = threading.Event()
        self._thread = threading.Thread(target=self._run, name="gga-monitor", daemon=True)

    def start(self) -> None:
        self._thread.start()

    def stop(self, timeout: float = 2.0) -> None:
        self._stop.set()
        self._thread.join(timeout=timeout)

    def latest(self, max_age: float) -> GgaFix | None:
        with self._lock:
            if self._latest is None:
                return None
            if time.monotonic() - self._latest.updated_at > max_age:
                return None
            return self._latest

    def _run(self) -> None:
        reader = NMEAReader(self._ser, quitonerror=1)
        while not self._stop.is_set():
            try:
                _raw, parsed = reader.read()
            except (serial.SerialException, OSError):
                break
            if parsed is None or getattr(parsed, "msgID", "") != "GGA":
                continue
            fix = gga_fix_from_parsed(
                parsed,
                _raw if isinstance(_raw, (bytes, bytearray)) else bytes(_raw),
            )
            if fix is None:
                continue
            with self._lock:
                self._latest = fix


class RosGgaMonitor:
    """Subscribe to nmea_msgs/Sentence and track the latest GGA fix."""

    def __init__(self, topic: str):
        try:
            import rclpy
            from nmea_msgs.msg import Sentence
            from rclpy.executors import SingleThreadedExecutor
        except ImportError as exc:
            raise RuntimeError(
                "ROS GGA source requires rclpy and nmea_msgs"
            ) from exc

        self._Sentence = Sentence
        self._lock = threading.Lock()
        self._latest: GgaFix | None = None
        self._stop = threading.Event()
        if not rclpy.ok():
            rclpy.init()
        self._node = rclpy.create_node("ntrip_aux_client_gga")
        self._sub = self._node.create_subscription(
            Sentence,
            topic,
            self._on_sentence,
            10,
        )
        self._executor = SingleThreadedExecutor()
        self._executor.add_node(self._node)
        self._thread = threading.Thread(target=self._spin, name="gga-ros-spin", daemon=True)

    def _spin(self) -> None:
        try:
            self._executor.spin()
        except Exception:
            if not self._stop.is_set():
                raise

    def _on_sentence(self, msg) -> None:
        sentence = (msg.sentence or "").strip()
        if not sentence or "GGA" not in sentence:
            return
        line = sentence if sentence.endswith("\r\n") else f"{sentence}\r\n"
        raw = line.encode("ascii", errors="ignore")
        try:
            reader = NMEAReader(BytesIO(raw), quitonerror=1)
            _raw, parsed = reader.read()
        except Exception:
            return
        fix = gga_fix_from_parsed(parsed, raw)
        if fix is None:
            return
        with self._lock:
            self._latest = fix

    def start(self) -> None:
        self._thread.start()

    def stop(self, timeout: float = 2.0) -> None:
        import rclpy

        self._stop.set()
        self._executor.shutdown()
        self._thread.join(timeout=timeout)
        if self._node.context.ok():
            self._node.destroy_node()

    def latest(self, max_age: float) -> GgaFix | None:
        with self._lock:
            if self._latest is None:
                return None
            if time.monotonic() - self._latest.updated_at > max_age:
                return None
            return self._latest


class GgaMonitorBase:
    def start(self) -> None:
        raise NotImplementedError

    def stop(self, timeout: float = 2.0) -> None:
        raise NotImplementedError

    def latest(self, max_age: float) -> GgaFix | None:
        raise NotImplementedError


class NtripAuxApp:
    """Calling app for GNSSNTRIPClient — supplies live GGA."""

    def __init__(self, monitor: GgaMonitorBase, max_gga_age: float):
        self._monitor = monitor
        self._max_gga_age = max_gga_age

    def get_coordinates(self) -> dict:
        fix = self._monitor.latest(self._max_gga_age)
        if fix is None or not fix.valid:
            raise ValueError("no valid GGA")
        return fix.as_coordinates()


class RtcmRosPublisher:
    """Publish RTCM bytes as rtcm_msgs/Message."""

    def __init__(self, topic: str, frame_id: str):
        try:
            import rclpy
            from rclpy.executors import SingleThreadedExecutor
            from rtcm_msgs.msg import Message
        except ImportError as exc:
            raise RuntimeError(
                "ROS2 publishing requires rclpy and rtcm_msgs "
                "(ros-humble-rtcm-msgs or similar)"
            ) from exc

        self._Message = Message
        if not rclpy.ok():
            rclpy.init()
        self._node = rclpy.create_node("ntrip_aux_client")
        self._pub = self._node.create_publisher(Message, topic, 10)
        self._frame_id = frame_id
        self._executor = SingleThreadedExecutor()
        self._executor.add_node(self._node)
        self._shutdown = threading.Event()
        self._thread = threading.Thread(target=self._spin, name="ros-spin", daemon=True)
        self._thread.start()
        self._count = 0

    def _spin(self) -> None:
        try:
            self._executor.spin()
        except Exception:
            if not self._shutdown.is_set():
                raise

    def publish(self, raw: bytes, parsed: object = None) -> None:
        import rclpy

        if self._shutdown.is_set() or not rclpy.ok():
            return
        msg = self._Message()
        msg.header.stamp = self._node.get_clock().now().to_msg()
        msg.header.frame_id = self._frame_id
        msg.message = list(raw)
        self._pub.publish(msg)
        self._count += 1
        if self._count == 1 or self._count % 100 == 0:
            identity = getattr(parsed, "identity", "?")
            logging.info(
                "Published RTCM #%d (%s, %d bytes) on %s",
                self._count,
                identity,
                len(raw),
                self._pub.topic_name,
            )

    def shutdown(self, timeout: float = 2.0) -> None:
        import rclpy

        if self._shutdown.is_set():
            return
        self._shutdown.set()
        self._executor.shutdown()
        self._thread.join(timeout=timeout)
        if self._node.context.ok():
            self._node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


class RtcmRelay:
    """Write RTCM to serial and optionally publish to ROS."""

    def __init__(
        self,
        ser: serial.Serial,
        output_queue: Queue,
        *,
        ros_publisher: RtcmRosPublisher | None,
        stop_event: threading.Event,
    ):
        self._ser = ser
        self._queue = output_queue
        self._ros = ros_publisher
        self._stop = stop_event
        self._thread = threading.Thread(target=self._run, name="rtcm-relay", daemon=True)

    def start(self) -> None:
        self._thread.start()

    def stop(self, timeout: float = 2.0) -> None:
        self._stop.set()
        self._thread.join(timeout=timeout)

    def _run(self) -> None:
        while not self._stop.is_set():
            try:
                raw, parsed = self._queue.get(timeout=0.5)
            except Empty:
                continue
            if self._stop.is_set():
                break
            if not isinstance(raw, (bytes, bytearray)):
                continue
            try:
                self._ser.write(raw)
            except (serial.SerialException, OSError):
                break
            if self._ros is not None:
                self._ros.publish(bytes(raw), parsed)


class RtcmQueuePublisher:
    """Drain RTCM queue and publish to ROS (no serial)."""

    def __init__(
        self,
        output_queue: Queue,
        ros_publisher: RtcmRosPublisher,
        stop_event: threading.Event,
    ):
        self._queue = output_queue
        self._ros = ros_publisher
        self._stop = stop_event
        self._thread = threading.Thread(target=self._run, name="rtcm-ros-only", daemon=True)

    def start(self) -> None:
        self._thread.start()

    def stop(self, timeout: float = 2.0) -> None:
        self._stop.set()
        self._thread.join(timeout=timeout)

    def _run(self) -> None:
        while not self._stop.is_set():
            try:
                raw, parsed = self._queue.get(timeout=0.5)
            except Empty:
                continue
            if self._stop.is_set():
                break
            if not isinstance(raw, (bytes, bytearray)):
                continue
            self._ros.publish(bytes(raw), parsed)


class NtripAuxBridge:
    def __init__(
        self,
        *,
        ntrip_cfg: dict,
        device: Path | None,
        baud: int | None,
        gga_source: str,
        gga_topic: str,
        ros_only: bool,
        rtcm_serial_relay: bool,
        gga_interval: int,
        gga_max_age: float,
        lost_fix_grace: float,
        release_port: bool,
        publish_rtcm: bool,
        rtcm_topic: str,
        rtcm_frame_id: str,
        verbosity: int,
    ):
        self._ntrip_cfg = ntrip_cfg
        self._device = device
        self._baud = baud
        self._gga_source = gga_source
        self._gga_topic = gga_topic
        self._ros_only = ros_only
        self._rtcm_serial_relay = rtcm_serial_relay
        self._gga_interval = gga_interval
        self._gga_max_age = gga_max_age
        self._lost_fix_grace = lost_fix_grace
        self._release_port = release_port
        self._publish_rtcm = publish_rtcm
        self._rtcm_topic = rtcm_topic
        self._rtcm_frame_id = rtcm_frame_id
        self._verbosity = verbosity
        self._stop = threading.Event()
        self._client: GNSSNTRIPClient | None = None
        self._connected_since: float | None = None
        self._last_valid_gga: float | None = None
        self._rtcm_queue: Queue | None = None
        self._rtcm_relay: RtcmRelay | None = None
        self._rtcm_ros_only: RtcmQueuePublisher | None = None
        self._ros_publisher: RtcmRosPublisher | None = None

    def stop(self) -> None:
        self._stop.set()
        if self._client is not None:
            self._client.stop()

    def _disconnect(self, reason: str) -> None:
        if self._client is None:
            return
        logging.info("Stopping NTRIP: %s", reason)
        self._client.stop()
        self._client = None
        self._connected_since = None

    def _connect(self, app: NtripAuxApp, ser: serial.Serial | None) -> None:
        cfg = self._ntrip_cfg
        output: serial.Serial | Queue
        if self._publish_rtcm or self._ros_only:
            assert self._rtcm_queue is not None
            output = self._rtcm_queue
        else:
            if ser is None:
                raise RuntimeError("serial output required when not publishing RTCM to ROS")
            output = ser

        self._client = GNSSNTRIPClient(app, verbosity=self._verbosity)
        self._client.run(
            server=cfg["caster"],
            port=cfg["caster_port"],
            https=0,
            mountpoint=cfg["mountpoint"],
            datatype="RTCM",
            version=ntrip_version(cfg.get("version", "v2")),
            ntripuser=cfg["username"],
            ntrippassword=cfg["password"],
            ggainterval=self._gga_interval,
            ggamode=GGALIVE,
            output=output,
            stopevent=self._client.stopevent,
        )
        self._connected_since = time.monotonic()
        logging.info(
            "NTRIP connected to %s:%s/%s",
            cfg["caster"],
            cfg["caster_port"],
            cfg["mountpoint"],
        )

    def run(self) -> int:
        if self._ros_only and not self._publish_rtcm:
            logging.error("--ros-only requires --publish-rtcm")
            return 1

        if self._gga_source == "ros_topic" and not self._gga_topic:
            logging.error("--gga-topic is required when --gga-source=ros_topic")
            return 1

        ser: serial.Serial | None = None
        monitor: GgaMonitorBase

        if not self._ros_only:
            assert self._device is not None and self._baud is not None
            if self._release_port:
                released = release_serial_port(self._device)
                if released:
                    logging.info(
                        "Cleared %d holder(s) on %s: %s",
                        len(released),
                        self._device,
                        ", ".join(str(pid) for pid in released),
                    )

        if self._publish_rtcm or self._ros_only:
            try:
                self._ros_publisher = RtcmRosPublisher(
                    self._rtcm_topic,
                    self._rtcm_frame_id,
                )
            except RuntimeError as exc:
                logging.error("%s", exc)
                return 1
            self._rtcm_queue = Queue()
            logging.info("ROS2 RTCM publishing enabled on %s", self._rtcm_topic)

        if self._gga_source == "ros_topic":
            try:
                monitor = RosGgaMonitor(self._gga_topic)
            except RuntimeError as exc:
                logging.error("%s", exc)
                return 1
            monitor.start()
            logging.info(
                "Listening for GGA on %s — NTRIP starts when fix quality >= %d",
                self._gga_topic,
                MIN_FIX_QUALITY,
            )
        else:
            assert self._device is not None and self._baud is not None
            try:
                ser = serial.Serial(str(self._device), self._baud, timeout=1)
            except serial.SerialException as exc:
                holders = port_holder_pids(self._device)
                hint = ""
                if holders:
                    hint = f" (held by PIDs: {', '.join(str(p) for p in holders)})"
                logging.error("Cannot open %s: %s%s", self._device, exc, hint)
                return 1
            monitor = GgaMonitor(ser)
            monitor.start()
            logging.info(
                "Listening for GGA on %s @ %d — NTRIP starts when fix quality >= %d",
                self._device,
                self._baud,
                MIN_FIX_QUALITY,
            )

        if self._ros_only:
            assert self._rtcm_queue is not None and self._ros_publisher is not None
            self._rtcm_ros_only = RtcmQueuePublisher(
                self._rtcm_queue,
                self._ros_publisher,
                self._stop,
            )
            self._rtcm_ros_only.start()
        elif self._publish_rtcm and self._rtcm_queue is not None:
            if self._rtcm_serial_relay and ser is not None:
                self._rtcm_relay = RtcmRelay(
                    ser,
                    self._rtcm_queue,
                    ros_publisher=self._ros_publisher,
                    stop_event=self._stop,
                )
                self._rtcm_relay.start()
            elif self._ros_publisher is not None:
                self._rtcm_ros_only = RtcmQueuePublisher(
                    self._rtcm_queue,
                    self._ros_publisher,
                    self._stop,
                )
                self._rtcm_ros_only.start()

        app = NtripAuxApp(monitor, self._gga_max_age)

        try:
            while not self._stop.is_set():
                fix = monitor.latest(self._gga_max_age)
                now = time.monotonic()

                if fix is not None and fix.valid:
                    self._last_valid_gga = now
                    if self._client is None:
                        self._connect(app, ser)
                elif self._client is not None:
                    last = self._last_valid_gga
                    if last is None or (now - last) > self._lost_fix_grace:
                        self._disconnect("GGA fix lost or stale")

                time.sleep(0.5)
        except KeyboardInterrupt:
            logging.info("Interrupted")
        finally:
            self._disconnect("shutdown")
            if self._rtcm_relay is not None:
                self._rtcm_relay.stop()
            if self._rtcm_ros_only is not None:
                self._rtcm_ros_only.stop()
            monitor.stop()
            if ser is not None:
                ser.close()
            if self._ros_publisher is not None:
                self._ros_publisher.shutdown()

        return 0


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    parser.add_argument(
        "--secrets",
        type=Path,
        default=default_secrets_path(),
        help="NTRIP credentials",
    )
    parser.add_argument(
        "--vehicle-config",
        type=Path,
        default=default_vehicle_config(),
        help="vehicle YAML for aux serial path/baud",
    )
    parser.add_argument(
        "--device",
        type=Path,
        default=None,
        help="override aux serial device",
    )
    parser.add_argument(
        "--baud",
        type=int,
        default=None,
        help="override aux serial baud rate",
    )
    parser.add_argument(
        "--release-port",
        action="store_true",
        help="terminate other processes holding the aux serial device",
    )
    parser.add_argument(
        "--gga-interval",
        type=int,
        default=10,
        help="seconds between GGA sentences sent to the NTRIP caster",
    )
    parser.add_argument(
        "--gga-max-age",
        type=float,
        default=5.0,
        help="ignore GGA sentences older than this many seconds",
    )
    parser.add_argument(
        "--lost-fix-grace",
        type=float,
        default=15.0,
        help="disconnect NTRIP after this many seconds without valid GGA",
    )
    parser.add_argument(
        "--publish-rtcm",
        action="store_true",
        help="publish received RTCM as rtcm_msgs/Message on ROS 2",
    )
    parser.add_argument(
        "--rtcm-topic",
        default="/rtcm",
        help="ROS 2 topic for rtcm_msgs/Message",
    )
    parser.add_argument(
        "--rtcm-frame-id",
        default="gnss",
        help="frame_id in RTCM message header",
    )
    parser.add_argument(
        "--gga-source",
        choices=["aux_serial", "ros_topic"],
        default="aux_serial",
        help="GGA fix source: aux serial NMEA or ROS nmea_msgs/Sentence topic",
    )
    parser.add_argument(
        "--gga-topic",
        default="",
        help="ROS topic for GGA when --gga-source=ros_topic",
    )
    parser.add_argument(
        "--ros-only",
        action="store_true",
        help="do not open aux serial; publish RTCM to ROS only (requires --publish-rtcm)",
    )
    parser.add_argument(
        "--no-serial-rtcm",
        action="store_true",
        help="do not write RTCM to aux serial (GGA may still use aux serial)",
    )
    parser.add_argument(
        "--verbosity",
        type=int,
        default=1,
        choices=[-1, 0, 1, 2, 3],
        help="pygnssutils log verbosity",
    )
    args = parser.parse_args()

    logging.basicConfig(
        level=logging.INFO,
        format="%(asctime)s %(levelname)s %(message)s",
        datefmt="%H:%M:%S",
    )

    try:
        ntrip_cfg = load_ntrip_config(args.secrets)
        default_device, default_baud = load_aux_serial(args.vehicle_config)
    except (FileNotFoundError, ValueError, OSError) as exc:
        logging.error("%s", exc)
        return 1

    device = args.device or (Path(default_device) if not args.ros_only else None)
    baud = args.baud if args.baud is not None else (default_baud if not args.ros_only else None)

    if args.gga_source == "ros_topic" and not args.gga_topic:
        logging.error("--gga-topic is required when --gga-source=ros_topic")
        return 1

    print_startup_config(
        ntrip_cfg=ntrip_cfg,
        secrets_path=args.secrets,
        vehicle_config=args.vehicle_config,
        device=device,
        baud=baud,
        gga_source=args.gga_source,
        gga_topic=args.gga_topic,
        ros_only=args.ros_only,
        gga_interval=args.gga_interval,
        gga_max_age=args.gga_max_age,
        lost_fix_grace=args.lost_fix_grace,
        release_port=args.release_port,
        publish_rtcm=args.publish_rtcm,
        rtcm_topic=args.rtcm_topic,
        rtcm_frame_id=args.rtcm_frame_id,
        verbosity=args.verbosity,
    )

    bridge = NtripAuxBridge(
        ntrip_cfg=ntrip_cfg,
        device=device,
        baud=baud,
        gga_source=args.gga_source,
        gga_topic=args.gga_topic,
        ros_only=args.ros_only,
        rtcm_serial_relay=not args.no_serial_rtcm,
        gga_interval=args.gga_interval,
        gga_max_age=args.gga_max_age,
        lost_fix_grace=args.lost_fix_grace,
        release_port=args.release_port,
        publish_rtcm=args.publish_rtcm,
        rtcm_topic=args.rtcm_topic,
        rtcm_frame_id=args.rtcm_frame_id,
        verbosity=args.verbosity,
    )
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    signal.signal(signal.SIGTERM, signal.SIG_DFL)
    return bridge.run()


if __name__ == "__main__":
    sys.exit(main())
