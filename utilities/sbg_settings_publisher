#!/usr/bin/env python3
"""Publish the SBG settings snapshot (sbg_settings --json) on a latched topic, so bags carry it.

sbg.launch.py reads the device with `sbg_settings --json --output <file>` before starting sbg_driver
(which then owns the serial port) and starts this node with that file. The JSON holds the device info,
every stored setting, our configuration, the comparison and the git commit of our config — or an
"error" if the read failed.

Topic `device_settings` (in the SBG namespace, e.g. /floatsam_usv_0/sbg/device_settings),
std_msgs/String, transient-local (late subscribers and `ros2 bag record` get it at once), re-sent every
`period_s` (default 30 s) so any recording window contains it.

  ros2 topic echo --once --qos-durability transient_local /floatsam_usv_0/sbg/device_settings
"""
import json

import rclpy
from rclpy.node import Node
from rclpy.qos import DurabilityPolicy, QoSProfile, ReliabilityPolicy
from std_msgs.msg import String


class SbgSettingsPublisher(Node):
    def __init__(self):
        super().__init__('sbg_settings_publisher')
        path = self.declare_parameter('settings_file', '').value
        period = float(self.declare_parameter('period_s', 30.0).value)
        try:
            with open(path, encoding='utf-8') as f:
                data = json.load(f)
        except (OSError, ValueError) as e:
            data = {'error': f'no settings snapshot ({path or "settings_file not set"}): {e}'}
        data['snapshot_file'] = path
        data['note'] = 'Read from the device before sbg_driver applied its configuration (sbg_settings).'
        self.msg = String(data=json.dumps(data, separators=(',', ':'), default=str))

        qos = QoSProfile(depth=1, durability=DurabilityPolicy.TRANSIENT_LOCAL, reliability=ReliabilityPolicy.RELIABLE)
        self.pub = self.create_publisher(String, 'device_settings', qos)
        self.pub.publish(self.msg)
        self.create_timer(period, lambda: self.pub.publish(self.msg))

        if 'error' in data:
            self.get_logger().warn(f'SBG settings snapshot has an error: {data["error"]}')
        else:
            info = data.get('device', {}).get('info', {})
            self.get_logger().info(
                f'publishing SBG settings ({info.get("productCode", "?")} S/N {info.get("serialNumber", "?")}, '
                f'{len(data.get("mismatches", []))} differ from ours) on {self.pub.topic_name} every {period:g} s')


def main():
    rclpy.init()
    node = SbgSettingsPublisher()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == '__main__':
    main()
