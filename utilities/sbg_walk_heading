#!/usr/bin/env python3
"""Straight-walk check: RTK track bearing vs SBG INS heading and raw dual-antenna heading; forward velocity sign
(SBG body velocity, robot_localization local odometry) and the global EKF track (smarc/odom_in_map) vs the raw RTK track.

Push the boat straight forward 10-15 m during the recording. Only RTK-fixed samples while moving count.
Usage: ros2 run usv_rtk_bringup sbg_walk_heading [seconds]   (robot floatsam_usv_0)
"""
import math, sys, time, rclpy
from rclpy.qos import qos_profile_sensor_data
from nav_msgs.msg import Odometry
from sbg_driver.msg import SbgGpsPos, SbgGpsHdt, SbgEkfQuat, SbgEkfVelBody

ROBOT = '/floatsam_usv_0'
N = ROBOT + '/sbg/sbg'
R = 6378137.0
pos, hdt, ekf, vbody, vlocal, odom_gps = [], [], [], [], [], []


def compass_from_enu_quat(q):
    yaw = math.degrees(math.atan2(2 * (q.w * q.z + q.x * q.y), 1 - 2 * (q.y ** 2 + q.z ** 2)))
    return (90.0 - yaw) % 360.0


def circ_mean(deg):
    s = sum(math.sin(math.radians(d)) for d in deg); c = sum(math.cos(math.radians(d)) for d in deg)
    return math.degrees(math.atan2(s, c)) % 360.0


def diff(a, b):
    return (a - b + 180.0) % 360.0 - 180.0


rclpy.init()
n = rclpy.create_node('sbg_walk_heading')
n.create_subscription(SbgGpsPos, N + '/gps_pos', lambda m: pos.append((time.time(), m.status.type, m.latitude, m.longitude)), qos_profile_sensor_data)
n.create_subscription(SbgGpsHdt, N + '/gps_hdt', lambda m: hdt.append((time.time(), m.true_heading)), qos_profile_sensor_data)
n.create_subscription(SbgEkfQuat, N + '/ekf_quat', lambda m: ekf.append((time.time(), compass_from_enu_quat(m.quaternion))), qos_profile_sensor_data)
n.create_subscription(SbgEkfVelBody, N + '/ekf_vel_body', lambda m: vbody.append((time.time(), m.velocity.x)), qos_profile_sensor_data)
n.create_subscription(Odometry, ROBOT + '/odometry/local', lambda m: vlocal.append((time.time(), m.twist.twist.linear.x)), qos_profile_sensor_data)
n.create_subscription(Odometry, ROBOT + '/smarc/odom_in_map', lambda m: odom_gps.append((time.time(), m.pose.pose.position.x, m.pose.pose.position.y)), qos_profile_sensor_data)

dur = float(sys.argv[1]) if len(sys.argv) > 1 else 60.0
print(f'Recording {dur:.0f} s — push the boat straight forward 10-15 m now.', flush=True)
end = time.time() + dur
while time.time() < end:
    rclpy.spin_once(n, timeout_sec=0.05)

fixed = [p for p in pos if p[1] == 7]
print(f'gps_pos samples {len(pos)}, RTK fixed {len(fixed)}')
if len(fixed) < 5:
    sys.exit('not enough RTK-fixed samples')
lat0, lon0 = fixed[0][2], fixed[0][3]
en = [(t, math.radians(lo - lon0) * R * math.cos(math.radians(lat0)), math.radians(la - lat0) * R) for t, _, la, lo in fixed]

# Moving segment: samples where speed over the next sample > 0.15 m/s.
moving = []
for a, b in zip(en, en[1:]):
    d = math.hypot(b[1] - a[1], b[2] - a[2]); dt = b[0] - a[0]
    if dt > 0 and d / dt > 0.15:
        moving.append((a[0], b[0]))
if not moving:
    sys.exit('no motion seen (> 0.15 m/s)')
t_start, t_end = moving[0][0], moving[-1][1]
seg = [p for p in en if t_start <= p[0] <= t_end]
de, dn = seg[-1][1] - seg[0][1], seg[-1][2] - seg[0][2]
length = math.hypot(de, dn)
bearing = math.degrees(math.atan2(de, dn)) % 360.0

# Straightness: max distance of any point from the start-end line.
off = max(abs((p[1] - seg[0][1]) * dn - (p[2] - seg[0][2]) * de) / length for p in seg) if length > 0 else float('nan')
h_ekf = circ_mean([h for t, h in ekf if t_start <= t <= t_end])
h_hdt = circ_mean([h for t, h in hdt if t_start <= t <= t_end])
print(f'walk: {length:.2f} m in {t_end - t_start:.1f} s, max sideways {off:.2f} m (straightness)')
print(f'RTK track bearing   {bearing:6.1f}°   (±{math.degrees(math.atan2(0.03, length)):.1f}° from 1.4 cm fixes)')
print(f'SBG EKF heading     {h_ekf:6.1f}°   EKF - track {diff(h_ekf, bearing):+5.1f}°')
print(f'raw HDT heading     {h_hdt:6.1f}°   HDT - track {diff(h_hdt, bearing):+5.1f}°')
mean = lambda xs: sum(xs) / len(xs) if xs else float('nan')  # noqa: E731
vb = mean([x for t, x in vbody if t_start <= t <= t_end]); vl = mean([x for t, x in vlocal if t_start <= t <= t_end])
v_track = length / (t_end - t_start)
print(f'forward speed: RTK track {v_track:.2f} m/s, SBG body vx {vb:+.2f}, local odometry vx {vl:+.2f}'
      f' — {"sign OK" if vb > 0 and vl > 0 else "SIGN WRONG (expected > 0 moving forward)"}')
# Global EKF (smarc/odom_in_map, map = ENU at the datum) vs RTK: compare the displacement over the walk, which is
# independent of the datum offset.
og = [p for p in odom_gps if t_start <= p[0] <= t_end]
if len(og) >= 2:
    ge, gn = og[-1][1] - og[0][1], og[-1][2] - og[0][2]
    print(f'global EKF displacement ({ge:+.2f} E, {gn:+.2f} N) vs RTK ({de:+.2f} E, {dn:+.2f} N): '
          f'difference {math.hypot(ge - de, gn - dn):.2f} m')
if length < 8:
    print('NOTE: walk shorter than 8 m — bearing less certain')
