def normalize_topic(topic: str) -> str:
    topic = topic.strip()
    if not topic.startswith('/'):
        topic = f'/{topic}'
    return topic


def sensor_namespace(topic: str) -> str | None:
    """Return /{robot}/{sensor} when the topic follows that layout."""
    parts = [part for part in topic.strip('/').split('/') if part]
    if len(parts) >= 3:
        return f'/{parts[0]}/{parts[1]}'
    return None


def sensor_label(topic: str) -> str:
    namespace = sensor_namespace(topic)
    if namespace:
        return namespace.strip('/')
    parts = [part for part in topic.strip('/').split('/') if part]
    if len(parts) >= 2:
        return '/'.join(parts[-2:])
    return parts[-1] if parts else topic


def namespace_label(namespace: str) -> str:
    return namespace.strip('/') or namespace


def is_sbg_namespace(namespace: str | None) -> bool:
    if not namespace:
        return False
    parts = [part for part in namespace.strip('/').split('/') if part]
    return len(parts) >= 2 and parts[1] == 'sbg'


def sbg_navsat_topic(namespace: str) -> str:
    return f'{namespace.rstrip("/")}/imu/nav_sat_fix'


def companion_topics(navsat_topic: str) -> dict[str, str]:
    """Map optional companion topics in the same namespace."""
    base, _, name = navsat_topic.rpartition('/')
    if not base:
        return {}
    companions: dict[str, str] = {}
    namespace = sensor_namespace(navsat_topic)

    if name == 'navsatfix':
        companions['gpsfix'] = f'{base}/gpsfix'
        companions['pvtgeodetic'] = f'{base}/pvtgeodetic'
        companions['gpgga'] = f'{base}/gpgga'
    elif name == 'nav_sat_fix' and is_sbg_namespace(namespace):
        companions['sbg_gps_pos'] = f'{namespace}/sbg/gps_pos'
        companions['sbg_gps_hdt'] = f'{namespace}/sbg/gps_hdt'

    if namespace is not None and not is_sbg_namespace(namespace):
        companions['atteuler'] = f'{base}/atteuler'
        companions['attcoveuler'] = f'{base}/attcoveuler'
    return companions


def discover_navsatfix_topics(node: Node) -> list[str]:
    topics: list[str] = []
    for name, types in node.get_topic_names_and_types():
        if 'sensor_msgs/msg/NavSatFix' in types:
            topics.append(name)
    return sorted(topics)


