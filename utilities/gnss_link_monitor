@dataclass
class StreamRate:
    window_s: float = 5.0
    times: deque[float] = field(default_factory=deque)
    sizes: deque[int] = field(default_factory=deque)
    last_rx: float = 0.0
    last_size: int = 0
    last_type: int | None = None
    recent_types: dict[int, int] = field(default_factory=dict)

    def tick(self, now: float, size: int, msg_type: int | None) -> None:
        self.times.append(now)
        self.sizes.append(size)
        self.last_rx = now
        self.last_size = size
        if msg_type is not None:
            self.last_type = msg_type
            self.recent_types[msg_type] = self.recent_types.get(msg_type, 0) + 1

        cutoff = now - self.window_s
        while self.times and self.times[0] < cutoff:
            self.times.popleft()
            self.sizes.popleft()

        if not self.times:
            self.recent_types.clear()

    def hz(self) -> float:
        if len(self.times) < 2:
            return 0.0
        span = self.times[-1] - self.times[0]
        if span <= 0:
            return 0.0
        return (len(self.times) - 1) / span

    def bytes_per_s(self) -> float:
        if len(self.times) < 2:
            return 0.0
        span = self.times[-1] - self.times[0]
        if span <= 0:
            return 0.0
        return sum(self.sizes) / span


