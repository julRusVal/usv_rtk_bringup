class LiveTerminal:
    """In-place terminal UI using the alternate screen and per-line clear."""

    def __init__(self) -> None:
        self._interactive = sys.stdout.isatty()
        self._prev_lines = 0
        self._active = False

    def start(self) -> None:
        if not self._interactive:
            return
        sys.stdout.write('\033[?1049h\033[H')
        sys.stdout.flush()
        self._active = True

    def update(self, lines: list[str]) -> None:
        text = '\n'.join(lines)
        if not self._interactive:
            sys.stdout.write('\033[2J\033[H' + text + '\n')
            sys.stdout.flush()
            return

        sys.stdout.write('\033[H')
        for line in lines:
            sys.stdout.write('\033[2K' + line + '\n')
        for _ in range(max(0, self._prev_lines - len(lines))):
            sys.stdout.write('\033[2K\n')
        self._prev_lines = len(lines)
        sys.stdout.flush()

    def stop(self) -> None:
        if not self._active:
            return
        sys.stdout.write('\033[?1049l')
        sys.stdout.flush()
        self._active = False

